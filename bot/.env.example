# Robinhood Chain RPC
RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Private key of the wallet that launched $BRICK on Pons (the creator; its fees sit in the Pons escrow)
CREATOR_PRIVATE_KEY=

# $BRICK contract address from Pons. Empty = standby. The curve is detected from the token.
TOKEN_ADDRESS=
CURVE_ADDRESS=

# KEEP cycles forward their ETH here. Empty = kept in the operator wallet.
TREASURY_ADDRESS=

# Escrow amount that triggers a cycle. Odd cycles burn, even cycles keep (same as token5).
BURN_THRESHOLD_ETH=0.01
KEEP_THRESHOLD_ETH=0.02

# 1 = never claim or buy; only burn $BRICK that lands in the operator wallet
BURN_ONLY=0

POLL_INTERVAL_SECONDS=10

# Read-only API for the site. Keep 127.0.0.1; the Next.js app reaches it through /api/engine.
PORT=5047
BOT_HOST=127.0.0.1
